# Quarterdeck reads these from the environment. `npm start` also loads a .env
# file if present; for `npm run dev`, export them in your shell.

# Where decisions come from: "fixtures" (default) or "cli" (a live privateer home).
QD_SOURCE=fixtures

# Required for QD_SOURCE=cli.
PRIVATEER_BIN=/path/to/privateer
PRIVATEER_HOME=/path/to/privateer/home

# Answers are only logged unless this is exactly 1 (and QD_SOURCE=cli).
QD_ALLOW_SEND=0

# Fixture directory for QD_SOURCE=fixtures.
QD_FIXTURES_DIR=fixtures

# Listen address. Loopback by default; change only behind an authenticating proxy.
HOST=127.0.0.1
PORT=3000
