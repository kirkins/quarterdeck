# Quarterdeck reads these from the environment. `npm start` also loads a .env
# file if present; for `npm run dev`, export them in your shell.
# Every variable is documented in README.md; the server setup is in docs/DEPLOY.md.

# Where decisions come from: "fixtures" (default) or "cli" (a live privateer home).
QD_SOURCE=fixtures

# Required for QD_SOURCE=cli.
PRIVATEER_BIN=/path/to/privateer
PRIVATEER_HOME=/path/to/privateer/home

# Answers are only logged unless this is exactly 1 (and QD_SOURCE=cli).
# Refused at startup when HOST is not loopback, unless QD_LOGIN_SECRET is set.
# Turn it on only after you have signed in and checked the login works.
QD_ALLOW_SEND=0

# The login: a scrypt hash of your passphrase, from `npm run hash-password`.
# Never the passphrase itself. Empty means no login, for loopback only.
# Keep it in single quotes. Example shape: 'scrypt$131072$8$1$<salt>$<hash>'
QD_LOGIN_SECRET=

# Session lifetime in hours (default 12), and idle timeout in minutes (default 120).
# QD_SESSION_HOURS=12
# QD_SESSION_IDLE_MINUTES=120

# Fixture directory for QD_SOURCE=fixtures.
QD_FIXTURES_DIR=fixtures

# Listen address. Loopback by default. A non-loopback address (the VPN address)
# needs ORIGIN set to the same address and port, and a firewall in front of it.
HOST=127.0.0.1
PORT=3000

# The public origin, as the browser sees it. Required when HOST is not loopback.
# An https:// origin also marks the session cookie Secure.
# ORIGIN=http://<vpn-address>:3000
